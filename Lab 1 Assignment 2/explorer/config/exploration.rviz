        - Alpha: 1
          Class: rviz/Axes
          Enabled: true
          Length: 10
          Name: Axes
          Radius: 0.10000000149011612
          Reference Frame: map
          Show Trail: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /flatland_server/debug/layer/2d
          Name: Map
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /flatland_server/debug/model/turtlebot
          Name: Robot
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Class: rviz/InteractiveMarkers
          Enable Transparency: true
          Enabled: true
          Name: Interact With Simulation
          Show Axes: false
          Show Descriptions: true
          Show Visual Aids: false
          Update Topic: /interactive_model_markers/update
          Value: true
      Enabled: true
      Name: Ground Truth
    - Class: rviz/Group
      Displays:
        - Alpha: 0.5
          Class: rviz/Map
          Color Scheme: map
          Draw Behind: false
          Enabled: true
          Name: Estimated Map
          Topic: /map
          Unreliable: false
          Use Timestamp: false
          Value: true
      Enabled: true
      Name: Estimation
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /visualization_marker
      Name: Marker
      Namespaces:
        robot_front_sphere: true
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /exploration_markers
      Name: Marker
      Namespaces:
        closest_point: true
        furthest_point: true
        scan_range: true
        target_direction: true
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
