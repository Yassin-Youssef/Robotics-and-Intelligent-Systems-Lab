<launch>
    <!-- Launch the autonomous explorer with custom parameters -->
    <node pkg="explorer" type="autonomous_explorer" name="autonomous_explorer" output="screen">
        <!-- Set behavior parameters -->
        <param name="forward_speed" value="0.3"/>
        <param name="rotation_speed" value="0.8"/>
        <param name="min_safe_distance" value="0.5"/>
        <param name="max_scan_angle" value="1.57"/>  <!-- 90 degrees in radians -->
    </node>
</launch>
